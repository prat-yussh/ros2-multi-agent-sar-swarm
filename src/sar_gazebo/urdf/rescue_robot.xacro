<?xml version="1.0"?>
<robot name="rescue_robot" xmlns:xacro="http://ros.org/wiki/xacro">
  <xacro:arg name="robot_name" default="robot"/>
  <xacro:arg name="color_rgba" default="0 0 1 1"/>

  <link name="$(arg robot_name)/base_link">
    <visual><geometry><box size="0.4 0.3 0.15"/></geometry><material name="body_color"><color rgba="$(arg color_rgba)"/></material></visual>
    <collision><geometry><box size="0.4 0.3 0.15"/></geometry></collision>
    <inertial><mass value="2.0"/><inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.02"/></inertial>
  </link>
  <gazebo reference="$(arg robot_name)/base_link"><visual><material><ambient>$(arg color_rgba)</ambient><diffuse>$(arg color_rgba)</diffuse></material></visual></gazebo>

  <link name="$(arg robot_name)/left_wheel"><visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual><collision><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="$(arg robot_name)/left_wheel_joint" type="continuous"><parent link="$(arg robot_name)/base_link"/><child link="$(arg robot_name)/left_wheel"/><origin xyz="0.1 0.175 -0.05" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/></joint>

  <link name="$(arg robot_name)/right_wheel"><visual><geometry><cylinder radius="0.1" length="0.05"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual><collision><geometry><cylinder radius="0.1" length="0.05"/></geometry></collision><inertial><mass value="0.5"/><inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/></inertial></link>
  <joint name="$(arg robot_name)/right_wheel_joint" type="continuous"><parent link="$(arg robot_name)/base_link"/><child link="$(arg robot_name)/right_wheel"/><origin xyz="0.1 -0.175 -0.05" rpy="-1.5708 0 0"/><axis xyz="0 0 1"/></joint>

  <link name="$(arg robot_name)/caster"><visual><geometry><sphere radius="0.05"/></geometry><material name="black"/></visual><collision><geometry><sphere radius="0.05"/></geometry></collision><inertial><mass value="0.2"/><inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/></inertial></link>
  <joint name="$(arg robot_name)/caster_joint" type="fixed"><parent link="$(arg robot_name)/base_link"/><child link="$(arg robot_name)/caster"/><origin xyz="-0.15 0 -0.1" rpy="0 0 0"/></joint>
  <gazebo reference="$(arg robot_name)/caster"><mu1>0.0</mu1><mu2>0.0</mu2></gazebo>

  <!-- NEW: Laser Scanner Link -->
  <link name="$(arg robot_name)/laser_frame"><visual><geometry><cylinder radius="0.05" length="0.05"/></geometry><material name="black"><color rgba="0.1 0.1 0.1 1"/></material></visual></link>
  <joint name="$(arg robot_name)/laser_joint" type="fixed"><parent link="$(arg robot_name)/base_link"/><child link="$(arg robot_name)/laser_frame"/><origin xyz="0.15 0 0.1" rpy="0 0 0"/></joint>
  
  <gazebo reference="$(arg robot_name)/laser_frame">
    <sensor name="lidar" type="gpu_lidar"><always_on>true</always_on><visualize>true</visualize><update_rate>10</update_rate><topic>/$(arg robot_name)/scan</topic><gz_frame_id>$(arg robot_name)/laser_frame</gz_frame_id>
      <ray><scan><horizontal><samples>360</samples><resolution>1.0</resolution><min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle></horizontal></scan><range><min>0.15</min><max>10.0</max><resolution>0.01</resolution></range></ray>
    </sensor>
  </gazebo>

  <gazebo>
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>$(arg robot_name)/left_wheel_joint</left_joint><right_joint>$(arg robot_name)/right_wheel_joint</right_joint>
      <wheel_separation>0.35</wheel_separation><wheel_radius>0.1</wheel_radius><odom_publish_frequency>30</odom_publish_frequency>
      <topic>/$(arg robot_name)/cmd_vel</topic><odom_topic>/$(arg robot_name)/odom</odom_topic>
      <frame_id>$(arg robot_name)/odom</frame_id><child_frame_id>$(arg robot_name)/base_link</child_frame_id>
    </plugin>
  </gazebo>
</robot>
